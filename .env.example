# Gmail address used to authenticate with smtp.gmail.com.
GMAIL_SMTP_USER=your-account@gmail.com

# A 16-character Google App Password, not the account's regular password.
GMAIL_SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Optional sender display name and destination inbox.
SMTP_FROM_NAME=Limitify Website
CONTACT_TO_EMAIL=team@limitify.rw
